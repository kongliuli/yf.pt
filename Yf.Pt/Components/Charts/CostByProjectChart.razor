@* 按项目成本柱图 *@
@if (Data == null || Data.Count == 0)
{
    <div class="text-muted p-4 text-center">暂无数据</div>
}
else
{
    <ApexChart TItem="CostSlice" Title="按项目成本 (¥)" Height="300" Options="_options">
        <ApexPointSeries TItem="CostSlice"
                         Name="成本"
                         SeriesType="SeriesType.Bar"
                         Items="Data"
                         XValue="@(x => x.Label)"
                         YValue="@(x => x.Amount)" />
    </ApexChart>
}

@code {
    [Parameter] public List<CostSlice>? Data { get; set; }

    private ApexChartOptions<CostSlice> _options = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } }
    };
}
