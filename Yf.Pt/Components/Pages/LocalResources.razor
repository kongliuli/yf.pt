@page "/local"
@inject LocalResourceService LocalService

<PageTitle>本地资源</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">本地资源</h1>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">+ 新增资源</button>
</div>

@if (_resources == null)
{
    <div class="text-muted p-5 text-center">加载中...</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>名称</th><th>类型</th><th>IP</th><th>位置</th><th>负责人</th><th>备注</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in _resources)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td><span class="badge bg-secondary">@r.Type</span></td>
                            <td>@(r.Ip ?? "-")</td>
                            <td>@(r.Location ?? "-")</td>
                            <td>@(r.Owner ?? "-")</td>
                            <td>@(r.Note ?? "-")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEdit(r)">编辑</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(r)">删除</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_editing != null)
{
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="modal-header">
                        <h5 class="modal-title">@(IsNew ? "新增本地资源" : "编辑本地资源")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">名称</label>
                            <InputText class="form-control" @bind-Value="_editing.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">类型</label>
                            <InputSelect class="form-select" @bind-Value="_editing.Type">
                                <option value="server">server</option>
                                <option value="vm">vm</option>
                                <option value="service">service</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">IP</label>
                            <InputText class="form-control" @bind-Value="_editing.Ip" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">位置</label>
                            <InputText class="form-control" @bind-Value="_editing.Location" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">负责人</label>
                            <InputText class="form-control" @bind-Value="_editing.Owner" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">备注</label>
                            <InputText class="form-control" @bind-Value="_editing.Note" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEdit">取消</button>
                        <button type="submit" class="btn btn-primary">保存</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<LocalResource>? _resources;
    private LocalResource? _editing;
    private bool IsNew;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        try { _resources = await LocalService.ListAsync(); }
        catch { _resources = new(); }
    }

    private void OpenCreate()
    {
        IsNew = true;
        _editing = new LocalResource { Type = "server" };
    }

    private void OpenEdit(LocalResource r)
    {
        IsNew = false;
        _editing = new LocalResource
        {
            Id = r.Id, Name = r.Name, Type = r.Type, Ip = r.Ip,
            Location = r.Location, Owner = r.Owner, Note = r.Note
        };
    }

    private void CloseEdit() => _editing = null;

    private async Task Save()
    {
        if (IsNew) await LocalService.AddAsync(_editing!);
        else await LocalService.UpdateAsync(_editing!);
        _editing = null;
        await Reload();
    }

    private async Task Delete(LocalResource r)
    {
        await LocalService.DeleteAsync(r.Id);
        await Reload();
    }
}
